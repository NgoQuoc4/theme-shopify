{% comment %}
  Instagram & Social Shoppable Grid Section - Japandi Furniture Theme
{% endcomment %}

<div class="instagram-grid section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="instagram-grid__header text-{{ section.settings.heading_alignment }}">
    {% if section.settings.subheading != blank %}
      <span class="instagram-grid__subheading caption-text">{{ section.settings.subheading | escape }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="instagram-grid__title h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  <div class="instagram-grid__items">
    {% for block in section.blocks %}
      <div class="instagram-grid__item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'instagram-grid__image', alt: 'Social post' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'instagram-grid__image' }}
        {% endif %}
        
        <a href="{{ block.settings.link | default: '#' }}" class="instagram-grid__overlay" target="_blank" rel="noopener">
          <svg class="instagram-grid__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
          {% if block.settings.handle != blank %}
            <span class="instagram-grid__handle">{{ block.settings.handle | escape }}</span>
          {% endif %}
        </a>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .instagram-grid__subheading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent, #A67C52);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }
  .instagram-grid__items {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  @media screen and (max-width: 989px) {
    .instagram-grid__items {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media screen and (max-width: 550px) {
    .instagram-grid__items {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .instagram-grid__item {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--card-corner-radius, 8px);
    overflow: hidden;
  }
  .instagram-grid__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .instagram-grid__item:hover .instagram-grid__image {
    transform: scale(1.08);
  }
  .instagram-grid__overlay {
    position: absolute;
    inset: 0;
    background: rgba(28, 28, 26, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #FFFFFF;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .instagram-grid__item:hover .instagram-grid__overlay {
    opacity: 1;
  }
  .instagram-grid__handle {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram Social Grid",
  "tag": "section",
  "class": "instagram-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Us @JapandiHome"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "INTERIOR INSPIRATION"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    }
  ],
  "blocks": [
    {
      "type": "social_post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Image"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle / Tag",
          "default": "@japandihome"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Social Grid",
      "blocks": [
        { "type": "social_post" },
        { "type": "social_post" },
        { "type": "social_post" },
        { "type": "social_post" },
        { "type": "social_post" }
      ]
    }
  ]
}
{% endschema %}
