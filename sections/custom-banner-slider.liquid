{% comment %}
  Custom Architectural Banner & Video Slider Section - Japandi Theme
  Supports 1, 2, 3, or 4 slides per view with Images & Video backgrounds.
{% endcomment %}

<div 
  class="banner-slider-section section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div 
    class="banner-slider"
    id="banner-slider-{{ section.id }}"
    data-slides-per-view="{{ section.settings.slides_per_view }}"
    data-autoplay="{{ section.settings.enable_autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  >
    <div class="banner-slider__track-container">
      <div class="banner-slider__track" id="banner-track-{{ section.id }}">
        {% for block in section.blocks %}
          <div 
            class="banner-slider__slide"
            style="--slide-columns: {{ section.settings.slides_per_view }}; --card-radius: {{ section.settings.card_radius }}px;"
            {{ block.shopify_attributes }}
          >
            <div class="banner-slider__card">
              {% comment %} Media Layer (Image or Video) {% endcomment %}
              <div class="banner-slider__media">
                {% if block.settings.media_type == 'video' and block.settings.video_url != blank %}
                  <video 
                    src="{{ block.settings.video_url }}" 
                    autoplay 
                    loop 
                    muted 
                    playsinline 
                    class="banner-slider__video"
                  ></video>
                {% elsif block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'banner-slider__img', alt: block.settings.heading }}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'banner-slider__img' }}
                {% endif %}

                {% comment %} Overlay Layer {% endcomment %}
                <div class="banner-slider__overlay" style="opacity: {{ block.settings.overlay_opacity | times: 0.01 }};"></div>
              </div>

              {% comment %} Content Layer {% endcomment %}
              <div class="banner-slider__content text-center">
                {% if block.settings.subheading != blank %}
                  <span class="banner-slider__subheading">{{ block.settings.subheading | escape }}</span>
                {% endif %}
                
                {% if block.settings.heading != blank %}
                  <h2 class="banner-slider__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <a href="{{ block.settings.button_link | default: '#' }}" class="banner-slider__btn button button--primary">
                    {{ block.settings.button_label | escape }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {% comment %} Floating Bottom Controls (Arrows + Dots) {% endcomment %}
    {% if section.blocks.size > 1 %}
      <div class="banner-slider__controls-wrapper">
        <div class="banner-slider__controls">
          <button type="button" class="banner-slider__arrow banner-slider__arrow--prev" aria-label="Previous slide">
            &lsaquo;
          </button>
          
          <div class="banner-slider__dots">
            {% for block in section.blocks %}
              <button 
                type="button" 
                class="banner-slider__dot{% if forloop.first %} is-active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {% endfor %}
          </div>

          <button type="button" class="banner-slider__arrow banner-slider__arrow--next" aria-label="Next slide">
            &rsaquo;
          </button>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .banner-slider-section {
    position: relative;
    overflow: hidden;
  }
  .banner-slider {
    position: relative;
    width: 100%;
  }
  .banner-slider__track-container {
    overflow: hidden;
    width: 100%;
  }
  .banner-slider__track {
    display: flex;
    gap: 20px;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .banner-slider__slide {
    flex: 0 0 calc((100% - (20px * (var(--slide-columns) - 1))) / var(--slide-columns));
    min-width: 0;
  }
  .banner-slider__card {
    position: relative;
    width: 100%;
    min-height: 480px;
    border-radius: var(--card-radius, 16px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .banner-slider__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .banner-slider__img,
  .banner-slider__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .banner-slider__overlay {
    position: absolute;
    inset: 0;
    background: #000000;
    z-index: 2;
    pointer-events: none;
  }
  .banner-slider__content {
    position: relative;
    z-index: 3;
    color: #FFFFFF;
    padding: 40px 24px;
    max-width: 650px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .banner-slider__subheading {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .banner-slider__heading {
    font-family: var(--font-heading-family);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }
  .banner-slider__btn {
    background-color: #FFFFFF;
    color: #1C1C1A;
    border-radius: 999px;
    padding: 12px 28px;
    font-size: 0.88rem;
    font-weight: 600;
    border: none;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .banner-slider__btn:hover {
    background-color: #FBF9F5;
    transform: scale(1.04);
  }

  /* Controls Floating Bar */
  .banner-slider__controls-wrapper {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }
  .banner-slider__controls {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(10px);
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .banner-slider__arrow {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 4px;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .banner-slider__arrow:hover {
    opacity: 1;
  }
  .banner-slider__dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .banner-slider__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .banner-slider__dot.is-active {
    width: 24px;
    border-radius: 999px;
    background: #FFFFFF;
  }

  @media screen and (max-width: 749px) {
    .banner-slider__slide {
      flex: 0 0 100% !important;
    }
    .banner-slider__heading {
      font-size: 1.8rem;
    }
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.getElementById('banner-slider-{{ section.id }}');
    if (!slider) return;

    const track = slider.querySelector('.banner-slider__track');
    const slides = slider.querySelectorAll('.banner-slider__slide');
    const prevBtn = slider.querySelector('.banner-slider__arrow--prev');
    const nextBtn = slider.querySelector('.banner-slider__arrow--next');
    const dots = slider.querySelectorAll('.banner-slider__dot');

    if (!track || slides.length === 0) return;

    let currentIndex = 0;
    const slidesPerView = parseInt(slider.dataset.slidesPerView) || 1;
    const maxIndex = Math.max(0, slides.length - slidesPerView);

    function updateSlider(index) {
      currentIndex = Math.min(Math.max(0, index), maxIndex);
      const slideWidth = slides[0].offsetWidth + 20; // 20px gap
      track.style.transform = `translateX(-${currentIndex * slideWidth}px)`;

      dots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === currentIndex);
      });
    }

    prevBtn?.addEventListener('click', () => updateSlider(currentIndex - 1));
    nextBtn?.addEventListener('click', () => updateSlider(currentIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.dataset.slideIndex);
        updateSlider(idx);
      });
    });

    if (slider.dataset.autoplay === 'true') {
      const speed = parseInt(slider.dataset.autoplaySpeed) || 5000;
      setInterval(() => {
        const nextIdx = currentIndex >= maxIndex ? 0 : currentIndex + 1;
        updateSlider(nextIdx);
      }, speed);
    }
  });
</script>

{% schema %}
{
  "name": "Banner Media Slider",
  "tag": "section",
  "class": "custom-banner-slider-section",
  "settings": [
    {
      "type": "range",
      "id": "slides_per_view",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides Visible Per View (Desktop)",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "label": "Card Corner Radius (px)",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Auto Slide",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "label": "Auto Slide Speed (seconds)",
      "default": 5
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Container Width",
      "options": [
        { "value": "narrow", "label": "Narrow (1000px)" },
        { "value": "page-width", "label": "Standard Page Width (1200px)" },
        { "value": "wide", "label": "Wide (1440px)" },
        { "value": "full-width", "label": "Full Width (100%)" }
      ],
      "default": "page-width"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video (MP4 / WebM)" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Background Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Direct Video MP4 URL"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 10,
          "label": "Dark Overlay Opacity (%)",
          "default": 30
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading / Eyebrow",
          "default": "Contemporary Grace"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Main Heading",
          "default": "Dining & Kitchen"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Architectural Banner Slider",
      "blocks": [
        { "type": "slide", "settings": { "heading": "Dining & Kitchen", "subheading": "Contemporary Grace" } },
        { "type": "slide", "settings": { "heading": "Living Room Sanctum", "subheading": "Minimalist Proportions" } }
      ]
    }
  ]
}
{% endschema %}
