{% comment %}
  Interactive Room Bundle Builder Section - Japandi & Scandinavian Furniture
  Combines multiple furniture products into a discounted room set with 1-click AJAX batch add to cart.
{% endcomment %}

<div class="room-bundle section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="room-bundle__header text-center">
    {% if section.settings.subheading != blank %}
      <span class="room-bundle__subheading caption-text">{{ section.settings.subheading | escape }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="room-bundle__title h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  <div class="room-bundle__grid">
    <div class="room-bundle__items">
      {% assign bundle_total = 0 %}
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          {% assign variant = product.selected_or_first_available_variant %}
          {% assign bundle_total = bundle_total | plus: variant.price %}
          <div class="room-bundle__card" {{ block.shopify_attributes }}>
            <div class="room-bundle__card-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
              {% endif %}
            </div>
            <div class="room-bundle__card-info">
              <h3 class="room-bundle__card-title">{{ product.title }}</h3>
              <span class="room-bundle__card-price">{{ variant.price | money }}</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="room-bundle__summary">
      <h3 class="room-bundle__summary-title">Bundle & Save</h3>
      <p class="room-bundle__summary-desc">Buy this curated room setup together and save <strong>{{ section.settings.discount_percent }}% OFF</strong> instantly!</p>
      
      {% assign discount_rate = 100 | minus: section.settings.discount_percent | divided_by: 100.0 %}
      {% assign discounted_total = bundle_total | times: discount_rate %}

      <div class="room-bundle__pricing">
        <span class="room-bundle__final-price">{{ discounted_total | money }}</span>
        {% if section.settings.discount_percent > 0 %}
          <s class="room-bundle__original-price">{{ bundle_total | money }}</s>
        {% endif %}
      </div>

      <button type="button" class="room-bundle__add-btn button button--primary" id="room-bundle-add-all-{{ section.id }}">
        Add Complete Set To Cart
      </button>
    </div>
  </div>
</div>

{% stylesheet %}
  .room-bundle__subheading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent, #A67C52);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }
  .room-bundle__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px;
    align-items: center;
    background-color: var(--color-bg-secondary, #F3EFEA);
    padding: 32px;
    border-radius: var(--card-corner-radius, 8px);
    border: 1px solid var(--color-border, #E5E0D8);
  }
  @media screen and (max-width: 989px) {
    .room-bundle__grid {
      grid-template-columns: 1fr;
    }
  }
  .room-bundle__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .room-bundle__card {
    display: flex;
    gap: 12px;
    align-items: center;
    background: #FFFFFF;
    padding: 12px;
    border-radius: 6px;
    border: 1px solid var(--color-border, #E5E0D8);
  }
  .room-bundle__card-image img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 4px;
  }
  .room-bundle__card-title {
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0 0 4px 0;
    color: #1C1C1A;
  }
  .room-bundle__card-price {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent, #A67C52);
  }
  .room-bundle__summary {
    background: #FFFFFF;
    padding: 24px;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    text-align: center;
  }
  .room-bundle__summary-title {
    margin-top: 0;
    font-family: var(--font-heading-family);
    color: #1C1C1A;
  }
  .room-bundle__summary-desc {
    font-size: 0.9rem;
    color: #6E6D68;
  }
  .room-bundle__pricing {
    margin-block: 16px;
  }
  .room-bundle__final-price {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1C1C1A;
  }
  .room-bundle__original-price {
    font-size: 1rem;
    color: #6E6D68;
    margin-left: 8px;
  }
  .room-bundle__add-btn {
    width: 100%;
    border-radius: 6px;
    padding: 14px 24px;
    font-weight: 600;
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Room Bundle Builder",
  "tag": "section",
  "class": "room-bundle-builder-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete The Dining Set"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CURATED ROOM SET"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "%",
      "label": "Bundle Discount Percentage",
      "default": 10
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Furniture Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Room Bundle Builder",
      "blocks": [
        { "type": "bundle_item" },
        { "type": "bundle_item" }
      ]
    }
  ]
}
{% endschema %}
