{% comment %}
  Newsletter Architecture Journal Subscription Section - Japandi Furniture Theme
{% endcomment %}

<div class="newsletter-journal section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="newsletter-journal__card">
    <div class="newsletter-journal__content text-center">
      {% if section.settings.subheading != blank %}
        <span class="newsletter-journal__subheading caption-text">{{ section.settings.subheading | escape }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="newsletter-journal__title h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="newsletter-journal__desc">{{ section.settings.text | escape }}</p>
      {% endif %}

      {% form 'customer', class: 'newsletter-journal__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, furniture_journal">
        <div class="newsletter-journal__form-group">
          <input 
            type="email" 
            name="contact[email]" 
            class="newsletter-journal__input" 
            placeholder="Enter your email address..." 
            required 
            aria-label="Email address"
          >
          <button type="submit" class="newsletter-journal__submit-btn button button--primary">
            Subscribe &rarr;
          </button>
        </div>
        {% if form.posted_successfully? %}
          <p class="newsletter-journal__success">Thank you for subscribing! Check your inbox for your 10% discount code.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .newsletter-journal__card {
    background-color: var(--color-bg-secondary, #F3EFEA);
    padding: 60px 24px;
    border-radius: var(--card-corner-radius, 8px);
    border: 1px solid var(--color-border, #E5E0D8);
    max-width: 900px;
    margin: 0 auto;
  }
  .newsletter-journal__subheading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent, #A67C52);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }
  .newsletter-journal__title {
    font-family: var(--font-heading-family);
    color: #1C1C1A;
    margin-bottom: 0.75rem;
  }
  .newsletter-journal__desc {
    color: #6E6D68;
    max-width: 540px;
    margin: 0 auto 2rem auto;
    font-size: 0.95rem;
  }
  .newsletter-journal__form-group {
    display: flex;
    max-width: 500px;
    margin: 0 auto;
    gap: 8px;
  }
  @media screen and (max-width: 550px) {
    .newsletter-journal__form-group {
      flex-direction: column;
    }
  }
  .newsletter-journal__input {
    flex: 1;
    padding: 14px 18px;
    border-radius: 6px;
    border: 1px solid var(--color-border, #E5E0D8);
    background: #FFFFFF;
    font-size: 0.9rem;
    color: #1C1C1A;
  }
  .newsletter-journal__input:focus {
    outline: none;
    border-color: var(--color-accent, #A67C52);
  }
  .newsletter-journal__submit-btn {
    padding: 14px 28px;
    border-radius: 6px;
    white-space: nowrap;
  }
  .newsletter-journal__success {
    color: #2E7D32;
    font-size: 0.85rem;
    margin-top: 12px;
    font-weight: 500;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter Journal",
  "tag": "section",
  "class": "newsletter-journal-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join The Interior Journal"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "EXCLUSIVE ACCESS & 10% OFF"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Subscribe to receive curated interior design lookbooks, new furniture collection drops, and $100 off your first white-glove order."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Journal"
    }
  ]
}
{% endschema %}
