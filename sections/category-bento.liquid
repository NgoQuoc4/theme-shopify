{% comment %}
  Category Bento Showcase Section - Japandi & Architectural Furniture
{% endcomment %}

<div class="category-bento section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="category-bento__header text-{{ section.settings.heading_alignment }}">
    {% if section.settings.subheading != blank %}
      <span class="category-bento__subheading caption-text">{{ section.settings.subheading | escape }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="category-bento__title h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  <div class="category-bento__grid">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      <a 
        href="{{ collection.url | default: '#' }}" 
        class="category-bento__card category-bento__card--{{ block.settings.card_size }}" 
        {{ block.shopify_attributes }}
      >
        <div class="category-bento__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'category-bento__image', alt: block.settings.title }}
          {% elsif collection.featured_image != blank %}
            {{ collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'category-bento__image', alt: collection.title }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'category-bento__image category-bento__placeholder' }}
          {% endif %}
          <div class="category-bento__overlay"></div>
        </div>

        <div class="category-bento__content">
          <h3 class="category-bento__card-title">
            {{ block.settings.title | default: collection.title | default: "Living Room Series" }}
          </h3>
          <span class="category-bento__link-text">
            Explore Category &rarr;
          </span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .category-bento__subheading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent, #A67C52);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }
  .category-bento__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 280px;
    gap: 20px;
  }
  @media screen and (max-width: 989px) {
    .category-bento__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 240px;
    }
  }
  @media screen and (max-width: 550px) {
    .category-bento__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 220px;
    }
  }
  .category-bento__card--large {
    grid-column: span 2;
    grid-row: span 2;
  }
  .category-bento__card--wide {
    grid-column: span 2;
  }
  .category-bento__card--standard {
    grid-column: span 1;
  }
  .category-bento__card {
    position: relative;
    border-radius: var(--card-corner-radius, 8px);
    overflow: hidden;
    display: block;
    text-decoration: none;
  }
  .category-bento__media {
    position: absolute;
    inset: 0;
  }
  .category-bento__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .category-bento__card:hover .category-bento__image {
    transform: scale(1.06);
  }
  .category-bento__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28, 28, 26, 0.65) 0%, rgba(28, 28, 26, 0.1) 60%);
  }
  .category-bento__content {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    color: #FFFFFF;
    z-index: 2;
  }
  .category-bento__card-title {
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0 0 6px 0;
    color: #FFFFFF;
  }
  .category-bento__link-text {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .category-bento__card:hover .category-bento__link-text {
    opacity: 1;
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Bento Grid",
  "tag": "section",
  "class": "category-bento-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore By Living Space"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CURATED CATEGORIES"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Category Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image"
        },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card Size Grid Span",
          "options": [
            { "value": "large", "label": "Large (2x2)" },
            { "value": "wide", "label": "Wide (2x1)" },
            { "value": "standard", "label": "Standard (1x1)" }
          ],
          "default": "standard"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Bento Grid",
      "blocks": [
        { "type": "category_card", "settings": { "card_size": "large" } },
        { "type": "category_card", "settings": { "card_size": "wide" } },
        { "type": "category_card", "settings": { "card_size": "standard" } },
        { "type": "category_card", "settings": { "card_size": "standard" } }
      ]
    }
  ]
}
{% endschema %}
