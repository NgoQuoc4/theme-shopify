{% comment %}
  Recently Viewed Products Section - Japandi & Architectural Furniture
  Saves viewed products to localStorage and dynamically renders product grid.
{% endcomment %}

<script src="{{ 'recently-viewed.js' | asset_url }}" type="module" fetchpriority="low"></script>

<recently-viewed-products
  class="recently-viewed section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url }}"
  data-product-img="{{ product.featured_image | image_url: width: 400 }}"
  data-product-price="{{ product.price | money }}"
  data-max-items="{{ section.settings.max_products }}"
>
  <div class="recently-viewed__header text-{{ section.settings.heading_alignment }}">
    {% if section.settings.subheading != blank %}
      <span class="recently-viewed__subheading caption-text">{{ section.settings.subheading | escape }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="recently-viewed__title h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  <div class="recently-viewed__grid" id="recently-viewed-container-{{ section.id }}">
    {% comment %} Injected dynamically via JS from localStorage {% endcomment %}
  </div>
</recently-viewed-products>

{% stylesheet %}
  .recently-viewed {
    display: none;
  }
  .recently-viewed.is-active {
    display: block;
  }
  .recently-viewed__subheading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent, #A67C52);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }
  .recently-viewed__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
  .recently-viewed__card {
    background-color: var(--color-bg-secondary, #F3EFEA);
    border-radius: var(--card-corner-radius, 8px);
    overflow: hidden;
    border: 1px solid var(--color-border, #E5E0D8);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: #1C1C1A;
    display: flex;
    flex-direction: column;
  }
  .recently-viewed__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
  }
  .recently-viewed__card-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .recently-viewed__card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .recently-viewed__card-title {
    font-family: var(--font-heading-family);
    font-size: 0.95rem;
    font-weight: 500;
    margin: 0;
    color: #1C1C1A;
    line-height: 1.3;
  }
  .recently-viewed__card-price {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent, #A67C52);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recently Viewed Products",
  "tag": "section",
  "class": "recently-viewed-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed Pieces"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "YOUR BROWSING HISTORY"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Max Products To Show",
      "default": 4
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "page-width", "label": "Page Width" },
        { "value": "full-width", "label": "Full Width" }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed Products"
    }
  ]
}
{% endschema %}
