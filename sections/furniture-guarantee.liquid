{% comment %}
  Furniture Guarantee & Service Highlights Section - Japandi Theme
{% endcomment %}

<div class="furniture-guarantee section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="furniture-guarantee__grid">
    <div class="furniture-guarantee__item">
      <div class="furniture-guarantee__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <h3 class="furniture-guarantee__title">10-Year Timber Warranty</h3>
      <p class="furniture-guarantee__desc">Crafted from FSC® solid wood with a structural guarantee that lasts for generations.</p>
    </div>

    <div class="furniture-guarantee__item">
      <div class="furniture-guarantee__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M1 3h15v13H1z"/>
          <path d="M16 8h4l3 3v5h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </div>
      <h3 class="furniture-guarantee__title">White-Glove In-Room Delivery</h3>
      <p class="furniture-guarantee__desc">Directly delivered, unboxed, and assembled in your room of choice by our team.</p>
    </div>

    <div class="furniture-guarantee__item">
      <div class="furniture-guarantee__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v4l3 3"/>
        </svg>
      </div>
      <h3 class="furniture-guarantee__title">30-Day In-Home Trial</h3>
      <p class="furniture-guarantee__desc">Try our furniture in your living space. Return hassle-free within 30 days if not delighted.</p>
    </div>

    <div class="furniture-guarantee__item">
      <div class="furniture-guarantee__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
      </div>
      <h3 class="furniture-guarantee__title">Sustainable Fair Pricing</h3>
      <p class="furniture-guarantee__desc">Direct-from-artisan pricing without middleman retail markups.</p>
    </div>
  </div>
</div>

{% stylesheet %}
  .furniture-guarantee__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    background-color: var(--color-bg-secondary, #F3EFEA);
    padding: 36px 28px;
    border-radius: var(--card-corner-radius, 8px);
    border: 1px solid var(--color-border, #E5E0D8);
  }
  .furniture-guarantee__item {
    text-align: center;
  }
  .furniture-guarantee__icon {
    color: var(--color-accent, #A67C52);
    margin-bottom: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }
  .furniture-guarantee__title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 6px 0;
    color: #1C1C1A;
  }
  .furniture-guarantee__desc {
    font-size: 0.84rem;
    color: #6E6D68;
    line-height: 1.45;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Furniture Guarantee",
  "tag": "section",
  "class": "furniture-guarantee-section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Container Width",
      "options": [
        { "value": "narrow", "label": "Narrow (1000px)" },
        { "value": "page-width", "label": "Standard Page Width (1200px)" },
        { "value": "wide", "label": "Wide (1440px)" },
        { "value": "full-width", "label": "Full Width (100%)" }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Furniture Guarantee"
    }
  ]
}
{% endschema %}
