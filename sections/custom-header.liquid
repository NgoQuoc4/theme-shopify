{% comment %}
  Custom Japandi Furniture Header Section - Multiple Layouts & Advanced Mega Menus
{% endcomment %}

{% comment %} theme-check-disable ValidScopedCSSClass {% endcomment %}
<script type="module" src="{{ 'custom-header.js' | asset_url }}" fetchpriority="low"></script>

{% liquid
  assign header_layout = section.settings.layout
  assign is_transparent = section.settings.enable_transparent
%}

<div 
  class="furniture-header furniture-header--{{ header_layout }}{% if is_transparent and template.name == 'index' %} furniture-header--transparent{% endif %}{% if section.settings.enable_sticky %} furniture-header--sticky{% endif %}"
  id="furniture-header-{{ section.id }}"
>
  <div class="furniture-header__announcement section-background color-custom-drawer">
    {% if section.settings.announcement_text != blank %}
      <div class="furniture-header__announcement-inner page-width text-center">
        <span>{{ section.settings.announcement_text }}</span>
      </div>
    {% endif %}
  </div>

  <header class="furniture-header__main page-width">
    {% comment %} Left Navigation or Logo depending on layout {% endcomment %}
    {% if header_layout == 'logo_center' %}
      <nav class="furniture-header__nav furniture-header__nav--split-left">
        {% render 'custom-header-menu', menu: section.settings.menu_left, blocks: section.blocks %}
      </nav>
    {% endif %}

    <div class="furniture-header__logo-wrapper">
      <a href="{{ routes.root_url }}" class="furniture-header__logo-link">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager', class: 'furniture-header__logo-img', alt: shop.name }}
        {% else %}
          <span class="furniture-header__logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    {% if header_layout == 'logo_left' or header_layout == 'transparent_overlay' %}
      <nav class="furniture-header__nav furniture-header__nav--center">
        {% render 'custom-header-menu', menu: section.settings.menu, blocks: section.blocks %}
      </nav>
    {% elsif header_layout == 'logo_center' %}
      <nav class="furniture-header__nav furniture-header__nav--split-right">
        {% render 'custom-header-menu', menu: section.settings.menu_right, blocks: section.blocks %}
      </nav>
    {% endif %}

    <div class="furniture-header__actions">
      <a href="{{ routes.search_url }}" class="furniture-header__action-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>

      <a href="{{ routes.account_url }}" class="furniture-header__action-btn" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="furniture-header__action-btn furniture-header__cart-btn" id="cart-icon-bubble" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="furniture-header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </header>
</div>

{% stylesheet %}
  .furniture-header {
    background-color: var(--color-bg-primary, #FBF9F5);
    border-bottom: 1px solid var(--color-border, #E5E0D8);
    position: relative;
    z-index: 50;
  }
  .furniture-header--transparent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
  }
  .furniture-header--sticky {
    position: sticky;
    top: 0;
    backdrop-filter: blur(12px);
    background-color: rgba(251, 249, 245, 0.92);
  }
  .furniture-header__announcement {
    padding-block: 8px;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background-color: var(--color-bg-secondary, #F3EFEA);
    border-bottom: 1px solid var(--color-border, #E5E0D8);
  }
  .furniture-header__main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 16px;
  }
  .furniture-header__logo-text {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #1C1C1A;
    text-decoration: none;
  }
  .furniture-header__nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .furniture-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .furniture-header__action-btn {
    color: #1C1C1A;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    position: relative;
  }
  .furniture-header__cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: var(--color-accent, #A67C52);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 600;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Header & Mega Menu",
  "tag": "section",
  "class": "furniture-header-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Header Layout Style",
      "options": [
        { "value": "logo_left", "label": "Logo Left, Centered Menu" },
        { "value": "logo_center", "label": "Centered Logo, Split Menu" },
        { "value": "transparent_overlay", "label": "Transparent Overlay (Homepage)" }
      ],
      "default": "logo_left"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "Enable Transparent Overlay on Homepage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Sticky Header on Scroll",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Bar Text",
      "default": "Free White-Glove In-Room Delivery & Assembly on orders over $500"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Split Menu Left (For Centered Logo Layout)"
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Split Menu Right (For Centered Logo Layout)"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu_promo",
      "name": "Mega Menu Promo Banner",
      "settings": [
        {
          "type": "text",
          "id": "parent_menu_title",
          "label": "Parent Menu Item Handle",
          "info": "Tên menu cha (Ví dụ: 'Living Room' hoặc 'Collections')"
        },
        {
          "type": "image_picker",
          "id": "promo_image_1",
          "label": "Promo Card Image 1"
        },
        {
          "type": "text",
          "id": "promo_heading_1",
          "label": "Promo 1 Title",
          "default": "New Japandi Sofa Series"
        },
        {
          "type": "url",
          "id": "promo_link_1",
          "label": "Promo 1 Link"
        },
        {
          "type": "image_picker",
          "id": "promo_image_2",
          "label": "Promo Card Image 2"
        },
        {
          "type": "text",
          "id": "promo_heading_2",
          "label": "Promo 2 Title",
          "default": "Artisan Dining Sets"
        },
        {
          "type": "url",
          "id": "promo_link_2",
          "label": "Promo 2 Link"
        }
      ]
    },
    {
      "type": "mega_menu_products",
      "name": "Mega Menu Products",
      "settings": [
        {
          "type": "text",
          "id": "parent_menu_title",
          "label": "Parent Menu Item Handle",
          "info": "Tên menu cha (Ví dụ: 'Furniture')"
        },
        {
          "type": "collection",
          "id": "featured_collection",
          "label": "Featured Collection Products"
        }
      ]
    },
    {
      "type": "mega_menu_tabs",
      "name": "Mega Menu Room Tabs",
      "settings": [
        {
          "type": "text",
          "id": "parent_menu_title",
          "label": "Parent Menu Item Handle",
          "info": "Tên menu cha (Ví dụ: 'Rooms')"
        },
        {
          "type": "image_picker",
          "id": "room_image_living",
          "label": "Living Room Image"
        },
        {
          "type": "image_picker",
          "id": "room_image_dining",
          "label": "Dining Room Image"
        },
        {
          "type": "image_picker",
          "id": "room_image_bedroom",
          "label": "Bedroom Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Header & Mega Menu",
      "blocks": [
        { "type": "mega_menu_promo", "settings": { "parent_menu_title": "Collections" } },
        { "type": "mega_menu_products", "settings": { "parent_menu_title": "Furniture" } }
      ]
    }
  ]
}
{% endschema %}
