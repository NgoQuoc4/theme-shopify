{%- doc -%}
  Renders a swatch either from a variant image object or a swatch object, with color name fallback for Japandi Furniture.

  @param {object} [swatch] - a swatch object
  @param {object} [variant_image] - an alternate image when there is no swatch value
  @param {string} [mode] - one of 'unscaled', 'filter', 'pill'
  @param {string} [label] - visually-hidden accessible label or name for the swatch
{%- enddoc -%}

{% liquid
  assign swatch_value = null
  assign extra_classes = ''

  if swatch.image
    assign swatch_image_url = swatch.image | image_url: width: 80
    assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
  elsif swatch.color
    assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
  elsif variant_image != blank
    assign swatch_image_url = variant_image | image_url: width: 80
    assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
    assign extra_classes = extra_classes | append: ' swatch--variant-image'
  else
    # Automatic Japandi Timber & Fabric Color Mapping Fallback based on option name
    assign name_lower = label | default: '' | downcase
    if name_lower contains 'bark' or name_lower contains 'brown'
      assign swatch_value = '#8B5A2B'
    elsif name_lower contains 'oak' or name_lower contains 'natural' or name_lower contains 'wood'
      assign swatch_value = '#D4B692'
    elsif name_lower contains 'walnut' or name_lower contains 'dark'
      assign swatch_value = '#5C4033'
    elsif name_lower contains 'cream' or name_lower contains 'beige' or name_lower contains 'sand' or name_lower contains 'boucle'
      assign swatch_value = '#F5F2EB'
    elsif name_lower contains 'black' or name_lower contains 'charcoal'
      assign swatch_value = '#1C1C1A'
    elsif name_lower contains 'terracotta' or name_lower contains 'rust'
      assign swatch_value = '#C86446'
    elsif name_lower contains 'white' or name_lower contains 'bleached'
      assign swatch_value = '#FFFFFF'
    elsif name_lower contains 'green' or name_lower contains 'olive'
      assign swatch_value = '#556B2F'
    elsif name_lower contains 'grey' or name_lower contains 'gray'
      assign swatch_value = '#808080'
    else
      assign swatch_value = '#A67C52'
    endif
  endif

  case mode
    when 'unscaled'
      assign extra_classes = extra_classes | append: ' swatch--unscaled'
    when 'filter'
      assign extra_classes = extra_classes | append: ' swatch--filter'
    when 'pill'
      assign extra_classes = extra_classes | append: ' swatch--pill'
  endcase
%}

<span
  class="swatch {{ extra_classes }}"
  style="--swatch-background: {{ swatch_value }}; border: 1px solid rgba(0,0,0,0.12);"
  title="{{ label | escape }}"
>
</span>
{%- if label != blank -%}
  <span class="visually-hidden">{{ label }}</span>
{%- endif -%}
