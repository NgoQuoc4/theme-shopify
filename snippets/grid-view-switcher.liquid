{% comment %}
  Grid View Switcher Component for Collection & Search Pages (PLP)
  Allows users to dynamically switch between 2-col, 3-col, 4-col, and List view layouts.
{% endcomment %}

<div class="grid-view-switcher" data-view-switcher>
  <span class="grid-view-switcher__label">View:</span>
  <div class="grid-view-switcher__buttons">
    <button type="button" class="grid-view-btn is-active" data-cols="4" aria-label="4 Columns View">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <rect x="2" y="2" width="4" height="20" rx="1"/>
        <rect x="8" y="2" width="4" height="20" rx="1"/>
        <rect x="14" y="2" width="4" height="20" rx="1"/>
        <rect x="20" y="2" width="4" height="20" rx="1"/>
      </svg>
    </button>
    <button type="button" class="grid-view-btn" data-cols="3" aria-label="3 Columns View">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <rect x="2" y="2" width="5" height="20" rx="1"/>
        <rect x="9.5" y="2" width="5" height="20" rx="1"/>
        <rect x="17" y="2" width="5" height="20" rx="1"/>
      </svg>
    </button>
    <button type="button" class="grid-view-btn" data-cols="2" aria-label="2 Columns View">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <rect x="2" y="2" width="9" height="20" rx="1"/>
        <rect x="13" y="2" width="9" height="20" rx="1"/>
      </svg>
    </button>
    <button type="button" class="grid-view-btn" data-cols="1" aria-label="List View">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <rect x="2" y="4" width="20" height="4" rx="1"/>
        <rect x="2" y="10" width="20" height="4" rx="1"/>
        <rect x="2" y="16" width="20" height="4" rx="1"/>
      </svg>
    </button>
  </div>
</div>

{% stylesheet %}
  .grid-view-switcher {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .grid-view-switcher__label {
    font-size: 0.85rem;
    color: var(--color-text-muted, #6E6D68);
    font-weight: 500;
  }
  .grid-view-switcher__buttons {
    display: flex;
    gap: 4px;
    background-color: var(--color-bg-secondary, #F3EFEA);
    padding: 3px;
    border-radius: 6px;
    border: 1px solid var(--color-border, #E5E0D8);
  }
  .grid-view-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: #6E6D68;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .grid-view-btn:hover {
    color: #1C1C1A;
  }
  .grid-view-btn.is-active {
    background: #FFFFFF;
    color: #1C1C1A;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }
{% endstylesheet %}
