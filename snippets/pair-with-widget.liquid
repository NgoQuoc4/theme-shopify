{% comment %}
  "Pair With / Complete The Look" Cross-Sell Widget for PDP
{% endcomment %}

{% assign recommendations_collection = product.collections.first %}
{% if recommendations_collection != blank and recommendations_collection.products.size > 1 %}
  <div class="furniture-pair-with">
    <h3 class="furniture-pair-with__heading h5">Complete The Architectural Look</h3>
    <p class="furniture-pair-with__sub">Curated items that pair seamlessly with {{ product.title | escape }}</p>

    <div class="furniture-pair-with__items">
      {% assign count = 0 %}
      {% for item in recommendations_collection.products %}
        {% if item.id != product.id and count < 2 %}
          {% assign count = count | plus: 1 %}
          <div class="furniture-pair-with__item">
            <a href="{{ item.url }}" class="furniture-pair-with__img-link">
              {% if item.featured_image %}
                <img src="{{ item.featured_image | image_url: width: 150 }}" alt="{{ item.title | escape }}" loading="lazy" class="furniture-pair-with__thumb" width="60" height="60">
              {% endif %}
            </a>
            <div class="furniture-pair-with__info">
              <a href="{{ item.url }}" class="furniture-pair-with__title">{{ item.title }}</a>
              <span class="furniture-pair-with__price">{{ item.price | money }}</span>
            </div>
            {% form 'product', item, class: 'furniture-pair-with__form' %}
              <input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}">
              <button type="submit" class="furniture-pair-with__add-btn button button--secondary" aria-label="Add {{ item.title | escape }} to cart">
                + Add
              </button>
            {% endform %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .furniture-pair-with {
    margin-block: 28px;
    padding: 20px;
    background-color: var(--color-bg-secondary, #F3EFEA);
    border-radius: 8px;
    border: 1px solid var(--color-border, #E5E0D8);
  }
  .furniture-pair-with__heading {
    margin-top: 0;
    margin-bottom: 2px;
    font-family: var(--font-heading-family);
    color: #1C1C1A;
  }
  .furniture-pair-with__sub {
    font-size: 0.82rem;
    color: #6E6D68;
    margin: 0 0 16px 0;
  }
  .furniture-pair-with__items {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .furniture-pair-with__item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #FFFFFF;
    padding: 10px 14px;
    border-radius: 6px;
    border: 1px solid var(--color-border, #E5E0D8);
  }
  .furniture-pair-with__img-link {
    flex-shrink: 0;
  }
  .furniture-pair-with__thumb {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 4px;
  }
  .furniture-pair-with__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .furniture-pair-with__title {
    font-size: 0.88rem;
    font-weight: 500;
    color: #1C1C1A;
    text-decoration: none;
    line-height: 1.25;
  }
  .furniture-pair-with__title:hover {
    color: var(--color-accent, #A67C52);
  }
  .furniture-pair-with__price {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent, #A67C52);
  }
  .furniture-pair-with__add-btn {
    padding: 6px 14px;
    font-size: 0.8rem;
    border-radius: 4px;
    white-space: nowrap;
    height: auto;
    min-height: unset;
  }
{% endstylesheet %}
